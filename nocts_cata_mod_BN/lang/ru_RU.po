msgstr "Лямбда"

#: Npc/c_npc.json
msgid "Red Team Slave Fighter"
msgstr "Боец-раб красной команды"

#: Npc/c_npc.json
msgid "Blue Team Slave Fighter"
msgstr "Боец-раб синей команды"

#: Surv_help/c_armor.json
msgid "survivor's archer backpack"
msgid_plural "survivor's archer backpacks"
msgstr[0] "рюкзак выживальщика-лучника"
msgstr[1] "рюкзака выживальщика-лучника"
msgstr[2] "рюкзаков выживальщика-лучника"

#. ~ Description for {'str': "survivor's archer backpack"}
#: Surv_help/c_armor.json
msgid "A custom-built backpack modified further to be an archer's best friend.  Lots of storage, manageable encumbrance and a built in quiver."
msgstr "Модифицированный самодельный рюкзак, дополнительно приспособленный для нужд лучника. Вместительный, не слишком стесняет движения и оснащён встроенным колчаном."

#: Surv_help/c_armor.json
msgid "survivor's scout suit"
msgid_plural "survivor's scout suits"
msgstr[0] "костюм выживальщика-разведчика"
msgstr[1] "костюма выживальщика-разведчика"
msgstr[2] "костюмов выживальщика-разведчика"

#. ~ Use action holster_msg for {'str': "survivor's scout suit"}.
#. ~ Use action holster_msg for {'str': "survivor's armored scout suit"}.
#: Surv_help/c_armor.json
msgid "You sheath your %s"
msgstr "Вы убираете %s в ножны"

#. ~ Use action holster_prompt for {'str': "survivor's scout suit"}.
#. ~ Use action holster_prompt for {'str': "survivor's armored scout suit"}.
#: Surv_help/c_armor.json
msgid "Sheath knife/sword"
msgstr "Убрать нож/меч в ножны"

#. ~ Description for {'str': "survivor's scout suit"}
#: Surv_help/c_armor.json
msgid "A home-made suit built to live off the land.  Comes with ample storage, fur lining, environmental and physical protection, a built-in watch, and a makeshift sheath ring.  It requires a separate gas mask for full protection."
msgstr "Кустарный костюм для автономной жизни вдали от цивилизации. В нём предусмотрено множество карманов, меховая подкладка, защита от непогоды и повреждений, встроенные часы и самодельное кольцо для крепления ножен. Для полной защиты органов дыхания необходим отдельный противогаз."

#: Surv_help/c_armor.json
msgid "survivor's armored scout suit"
msgid_plural "survivor's armored scout suits"
msgstr[0] "бронированный костюм выживальщика-разведчика"
msgstr[1] "бронированных костюма выживальщика-разведчика"
msgstr[2] "бронированных костюмов выживальщика-разведчика"

#. ~ Description for {'str': "survivor's armored scout suit"}
#: Surv_help/c_armor.json
msgid "A home-made suit built to live off the land.  Comes with ample storage, warm fur lining, environmental and physical protection, a built in watch, and a makeshift sheath ring.  The suit is carefully crafted of Kevlar fabric and reinforced with metal.  It requires a separate gas mask for full protection."
msgstr "Кустарный костюм для автономной жизни вдали от цивилизации. В нём предусмотрено множество карманов, тёплая меховая подкладка, защита от непогоды и повреждений, встроенные часы и самодельное кольцо для крепления ножен. Костюм тщательно сшит из кевларовой ткани и усилен металлическими элементами. Для полной защиты органов дыхания необходим отдельный противогаз."

